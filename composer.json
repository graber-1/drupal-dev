{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://git.drupalcode.org/issue/marketo_ma-3576016.git"
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "ext-json": "*",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.4",
        "drupal/codemirror_editor": "^2.0",
        "drupal/coder": "^8.3",
        "drupal/contact_block": "^2.0",
        "drupal/contact_storage": "^1.0",
        "drupal/core": "^11",
        "drupal/core-composer-scaffold": "^11",
        "drupal/key": "^1.0",
        "drupal/openid_connect": "3.x-dev@dev",
        "drupal/views_bulk_operations": "^4.4",
        "drush/drush": "^13.7",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "chi-teck/drupal-coder-extension": "^1.2",
        "drupal/config_inspector": "^2.1",
        "drupal/core-dev": "^11",
        "drupal/devel": "^5.5",
        "drupal/developer_console": "^1.0@dev",
        "drupal/openid_connect_windows_aad": "^2.0@beta",
        "drupal/workspace_config": "1.0.x-dev@dev",
        "mglaman/phpstan-drupal": "^2.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/phpstan": "^2.1.26",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9 || ^10.5 || ^11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    },
    "scripts": {
        "si": "drush site:install -v minimal --existing-config --yes --sites-subdir=default",
        "sid": "drush site:install -v minimal --existing-config --yes --sites-subdir=default && drush lms-ctt --simple-passwords && drush en -y developer_console && drush uli",
        "test-environment": "drush si minimal --yes && drush thin claro && drush cset system.theme default claro -y && drush pm:install dblog block page_cache dynamic_page_cache lms lms_answer_plugins lms_answer_comments -y && drush lms-ctt --simple-passwords"
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches-file": "composer.patches.json",
        "patchLevel": {
            "drupal/core": "-p2"
        }
    }
}
